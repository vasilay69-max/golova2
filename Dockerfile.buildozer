FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git zip unzip openjdk-21-jdk-headless autoconf libtool pkg-config \
    zlib1g-dev libncurses-dev libtinfo6 cmake libffi-dev libssl-dev \
    automake autopoint gettext patch make gcc g++ libltdl-dev \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем Buildozer, Cython строго 0.29.34 и вспомогательные пакеты
RUN pip install --no-cache-dir \
    buildozer==1.6.0 \
    cython==0.29.34 \
    setuptools \
    legacy-cgi

WORKDIR /home/user/hostcwd
